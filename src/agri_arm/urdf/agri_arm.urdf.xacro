<?xml version="1.0"?>
<!-- Six-axis harvesting arm based on docs/harvesting_robot_hardware_comparison.md.
     Joint modules: RMD-X6 (base yaw, elbow), RMD-X8 (shoulder),
     DYNAMIXEL XM540 x2 and XM430 x1 (wrist). Masses and lengths are first
     estimates for simulation; update them from the CAD model and real parts.
     The hand is a two-finger gripper with a sliding blade (hand:=true),
     or one lumped mass on the tool flange (hand:=false). -->
<robot name="agri_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers" default="$(find agri_arm)/config/controllers.yaml"/>
  <!-- position: Gazebo moves each joint to the commanded angle (ideal servo).
       effort: the controller's PID outputs joint torque, so acceleration
       torques and torque saturation show up. Use controllers_effort.yaml. -->
  <xacro:arg name="control_mode" default="position"/>
  <!-- Extra mass [kg] held at tool0, such as a fruit and cables. -->
  <xacro:arg name="payload" default="0.0"/>
  <!-- true: fingers and blade as moving joints. false: one lumped tool of
       the same mass, for tools that expect only the six arm joints. -->
  <xacro:arg name="hand" default="true"/>
  <!-- Gazebo model names (space separated) the hand can hold. Each gets a
       detachable joint from link6 with topics /<name>/hand/attach and
       /<name>/hand/detach. Gazebo attaches these joints as soon as the arm
       is spawned, so the user must send detach before moving the arm. -->
  <xacro:arg name="grasp_objects" default=""/>

  <!-- ===== Dimensions [m] and masses [kg] ===== -->
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="shoulder_height" value="0.10"/>
  <xacro:property name="upper_arm" value="0.35"/>
  <xacro:property name="forearm_root" value="0.06"/>   <!-- elbow to wrist roll motor -->
  <xacro:property name="forearm" value="0.24"/>        <!-- wrist roll motor to wrist pitch -->
  <xacro:property name="wrist_roll" value="0.06"/>     <!-- wrist pitch to tool roll -->
  <xacro:property name="flange" value="0.03"/>

  <xacro:property name="m_rmd_x8" value="1.40"/>
  <xacro:property name="m_rmd_x6" value="0.78"/>
  <xacro:property name="m_xm540" value="0.165"/>
  <xacro:property name="m_xm430" value="0.082"/>
  <xacro:property name="m_tool" value="0.65"/>          <!-- hand + cutter + camera estimate -->
  <xacro:property name="hand" value="$(arg hand)"/>
  <!-- Hand (hand:=true): masses add up to m_tool. -->
  <xacro:property name="m_finger" value="0.03"/>
  <xacro:property name="m_blade" value="0.04"/>
  <xacro:property name="m_palm" value="${m_tool - 2 * m_finger - m_blade}"/>
  <xacro:property name="palm_len" value="0.06"/>        <!-- along the tool axis -->
  <xacro:property name="palm_x" value="-0.015"/>        <!-- palm sits above the fruit -->
  <xacro:property name="finger_len" value="0.05"/>
  <xacro:property name="finger_t" value="0.006"/>
  <xacro:property name="finger_open" value="0.03"/>     <!-- half gap when open -->
  <xacro:property name="cut_above" value="0.015"/>      <!-- blade above the finger center -->
  <xacro:property name="wrist_cam_x" value="-0.0575"/>  <!-- on the palm top (-x is up) -->
  <xacro:property name="wrist_cam_z" value="0.075"/>
  <xacro:property name="wrist_cam_pitch" value="${15 * pi / 180}"/>

  <!-- ===== Inertia helpers ===== -->
  <!-- Solid cylinder along z, centered at (0 0 cz). -->
  <xacro:macro name="cyl_inertial" params="m r h cz">
    <inertial>
      <origin xyz="0 0 ${cz}"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (3 * r * r + h * h) / 12}" ixy="0" ixz="0"
               iyy="${m * (3 * r * r + h * h) / 12}" iyz="0" izz="${m * r * r / 2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="color" params="link rgb">
    <gazebo reference="${link}">
      <visual><material><ambient>${rgb} 1</ambient><diffuse>${rgb} 1</diffuse></material></visual>
    </gazebo>
  </xacro:macro>

  <!-- Joint with limits taken from the module. effort is the rated torque for
       RMD modules. For DYNAMIXEL it is a provisional value below the stall
       torque, not a verified continuous rating; replace it after tests. -->
  <xacro:macro name="arm_joint" params="name parent child xyz axis lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ===== Links ===== -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Pedestal with the RMD-X6 base yaw motor inside. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2}"/>
      <geometry><cylinder radius="0.09" length="${base_height}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height / 2}"/>
      <geometry><cylinder radius="0.09" length="${base_height}"/></geometry>
    </collision>
    <xacro:cyl_inertial m="${2.0 + m_rmd_x6}" r="0.09" h="${base_height}" cz="${base_height / 2}"/>
  </link>
  <xacro:color link="base_link" rgb="0.3 0.3 0.3"/>

  <xacro:arm_joint name="joint1" parent="base_link" child="link1" xyz="0 0 ${base_height}"
                   axis="0 0 1" lower="-2.97" upper="2.97" effort="20" velocity="2.0"/>

  <!-- Turret carrying the RMD-X8 shoulder motor (axis along y). -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 ${shoulder_height / 2}"/>
      <geometry><box size="0.10 0.08 ${shoulder_height}"/></geometry>
    </visual>
    <visual name="shoulder_motor">
      <origin xyz="0 0 ${shoulder_height}" rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="0.055" length="0.12"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${shoulder_height / 2}"/>
      <geometry><box size="0.10 0.08 ${shoulder_height}"/></geometry>
    </collision>
    <xacro:cyl_inertial m="${0.3 + m_rmd_x8}" r="0.055" h="0.12" cz="${shoulder_height * 0.8}"/>
  </link>
  <xacro:color link="link1" rgb="0.15 0.15 0.15"/>

  <xacro:arm_joint name="joint2" parent="link1" child="link2" xyz="0 0 ${shoulder_height}"
                   axis="0 1 0" lower="-1.75" upper="1.75" effort="43" velocity="1.5"/>

  <!-- Upper arm tube (0.4 kg) with the RMD-X6 elbow motor at its end. -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 ${upper_arm / 2}"/>
      <geometry><box size="0.05 0.05 ${upper_arm}"/></geometry>
    </visual>
    <visual name="elbow_motor">
      <origin xyz="0 0 ${upper_arm}" rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="0.045" length="0.09"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_arm / 2}"/>
      <geometry><box size="0.05 0.05 ${upper_arm}"/></geometry>
    </collision>
    <!-- Center of mass: (0.4 * L/2 + 0.78 * L) / 1.18 -->
    <xacro:cyl_inertial m="${0.4 + m_rmd_x6}" r="0.03" h="${upper_arm}"
                        cz="${(0.4 * upper_arm / 2 + m_rmd_x6 * upper_arm) / (0.4 + m_rmd_x6)}"/>
  </link>
  <xacro:color link="link2" rgb="0.85 0.85 0.85"/>

  <xacro:arm_joint name="joint3" parent="link2" child="link3" xyz="0 0 ${upper_arm}"
                   axis="0 1 0" lower="-2.6" upper="2.6" effort="20" velocity="2.0"/>

  <!-- Forearm root with the XM540 wrist roll motor. -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 ${forearm_root / 2}"/>
      <geometry><box size="0.045 0.045 ${forearm_root}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${forearm_root / 2}"/>
      <geometry><box size="0.045 0.045 ${forearm_root}"/></geometry>
    </collision>
    <xacro:cyl_inertial m="${0.12 + m_xm540}" r="0.025" h="${forearm_root}" cz="${forearm_root * 0.6}"/>
  </link>
  <xacro:color link="link3" rgb="0.85 0.85 0.85"/>

  <!-- XM540-W270: stall 10.6 N·m at 12 V. 6 N·m is a provisional reference.
       No-load speed at 12 V is 30 rpm (3.14 rad/s) and the torque falls to
       zero there; at 2.0 rad/s it still gives about 3.8 N·m (agri_arm
       motors.py), so the limit is 2.0. -->
  <xacro:arm_joint name="joint4" parent="link3" child="link4" xyz="0 0 ${forearm_root}"
                   axis="0 0 1" lower="-3.14" upper="3.14" effort="6" velocity="2.0"/>

  <!-- Forearm tube (0.2 kg) with the XM540 wrist pitch motor at its end. -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 ${forearm / 2}"/>
      <geometry><cylinder radius="0.02" length="${forearm}"/></geometry>
    </visual>
    <visual name="wrist_motor">
      <origin xyz="0 0 ${forearm}"/>
      <geometry><box size="0.034 0.05 0.034"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${forearm / 2}"/>
      <geometry><cylinder radius="0.02" length="${forearm}"/></geometry>
    </collision>
    <xacro:cyl_inertial m="${0.2 + m_xm540}" r="0.02" h="${forearm}"
                        cz="${(0.2 * forearm / 2 + m_xm540 * forearm) / (0.2 + m_xm540)}"/>
  </link>
  <xacro:color link="link4" rgb="0.0 0.55 0.25"/>

  <xacro:arm_joint name="joint5" parent="link4" child="link5" xyz="0 0 ${forearm}"
                   axis="0 1 0" lower="-2.0" upper="2.0" effort="6" velocity="2.0"/>

  <!-- Wrist bracket with the XM430 tool roll motor. -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 ${wrist_roll / 2}"/>
      <geometry><box size="0.03 0.03 ${wrist_roll}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${wrist_roll / 2}"/>
      <geometry><box size="0.03 0.03 ${wrist_roll}"/></geometry>
    </collision>
    <xacro:cyl_inertial m="${0.05 + m_xm430}" r="0.018" h="${wrist_roll}" cz="${wrist_roll * 0.6}"/>
  </link>
  <xacro:color link="link5" rgb="0.0 0.55 0.25"/>

  <!-- XM430-W350: stall 4.1 N·m at 12 V. 2.5 N·m is a provisional reference.
       No-load speed at 12 V is 46 rpm (4.82 rad/s); the limit 3.0 leaves
       about 1.5 N·m (motors.py). -->
  <xacro:arm_joint name="joint6" parent="link5" child="link6" xyz="0 0 ${wrist_roll}"
                   axis="0 0 1" lower="-3.14" upper="3.14" effort="2.5" velocity="3.0"/>

  <!-- Box inertia about its center. -->
  <xacro:macro name="box_inertial" params="m x y z xyz">
    <inertial>
      <origin xyz="${xyz}"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (y * y + z * z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x * x + z * z) / 12}" iyz="0" izz="${m * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="box_link" params="name m x y z xyz:='0 0 0'">
    <link name="${name}">
      <visual><origin xyz="${xyz}"/><geometry><box size="${x} ${y} ${z}"/></geometry></visual>
      <collision><origin xyz="${xyz}"/><geometry><box size="${x} ${y} ${z}"/></geometry></collision>
      <xacro:box_inertial m="${m}" x="${x}" y="${y}" z="${z}" xyz="${xyz}"/>
    </link>
  </xacro:macro>

  <xacro:if value="${hand}">
    <!-- Cut-and-hold hand. Two fingers close on the fruit stem (peduncle)
         at tool0, and a blade slides across the stem 1.5 cm above the
         fingers, so the cut-off fruit stays held by its stem. In the tool
         frame z points forward and -x is "up" when the tool faces the plant
         (see harvest_demo). The palm holds the finger and blade servos
         (DYNAMIXEL XL430 / XL330 class). Masses are estimates and add up
         to the old lumped tool (0.65 kg). -->
    <link name="link6">
      <visual>
        <origin xyz="0 0 ${flange / 2}"/>
        <geometry><cylinder radius="0.03" length="${flange}"/></geometry>
      </visual>
      <visual name="wrist_camera">
        <origin xyz="${wrist_cam_x} 0 ${wrist_cam_z}"/>
        <geometry><box size="0.025 0.06 0.025"/></geometry>
      </visual>
      <collision name="wrist_camera">
        <origin xyz="${wrist_cam_x} 0 ${wrist_cam_z}"/>
        <geometry><box size="0.025 0.06 0.025"/></geometry>
      </collision>
      <visual name="palm">
        <origin xyz="${palm_x} 0 ${flange + palm_len / 2}"/>
        <geometry><box size="0.06 0.09 ${palm_len}"/></geometry>
      </visual>
      <collision>
        <origin xyz="${palm_x} 0 ${flange + palm_len / 2}"/>
        <geometry><box size="0.06 0.09 ${palm_len}"/></geometry>
      </collision>
      <xacro:box_inertial m="${m_palm}" x="0.06" y="0.09" z="${palm_len}"
                          xyz="${palm_x} 0 ${flange + palm_len / 2}"/>
    </link>
    <xacro:color link="link6" rgb="0.9 0.5 0.1"/>

    <!-- Finger joints: 0 = open (inner faces 3 cm from the center),
         finger_close = closed on a stem of radius stem_radius. -->
    <xacro:macro name="finger" params="side sign">
      <joint name="finger_${side}_joint" type="prismatic">
        <parent link="link6"/>
        <child link="finger_${side}"/>
        <origin xyz="0 ${sign * (finger_open + finger_t / 2)} ${flange + palm_len + finger_len / 2}"/>
        <axis xyz="0 ${-sign} 0"/>
        <limit lower="0" upper="${finger_open - 0.001}" effort="20" velocity="0.1"/>
        <dynamics damping="1.0"/>
      </joint>
      <xacro:box_link name="finger_${side}" m="${m_finger}" x="0.02" y="${finger_t}" z="${finger_len}"/>
      <xacro:color link="finger_${side}" rgb="0.25 0.25 0.25"/>
    </xacro:macro>
    <xacro:finger side="left" sign="1"/>
    <xacro:finger side="right" sign="-1"/>

    <!-- Blade: 0 = open beside the left finger, 0.06 = past the stem. -->
    <joint name="cutter_joint" type="prismatic">
      <parent link="link6"/>
      <child link="cutter"/>
      <origin xyz="${-cut_above} 0.045 ${flange + palm_len + finger_len - 0.015}"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="0.06" effort="50" velocity="0.2"/>
      <dynamics damping="1.0"/>
    </joint>
    <xacro:box_link name="cutter" m="${m_blade}" x="0.002" y="0.03" z="0.03"/>
    <xacro:color link="cutter" rgb="0.75 0.75 0.8"/>

    <!-- Wrist RGB-D camera on top of the palm, looking forward along the
         tool axis and 15 degrees down toward the fingers, to see the stem
         from close by before the grasp. Its body is part of link6 (palm
         mass includes it); these links only carry the frames. -->
    <joint name="wrist_camera_joint" type="fixed">
      <parent link="link6"/>
      <child link="wrist_camera_link"/>
      <!-- Camera +x (view) = tool +z, camera +z = tool -x, then 15° down. -->
      <origin xyz="${wrist_cam_x} 0 ${wrist_cam_z}" rpy="0 ${-pi / 2 + wrist_cam_pitch} 0"/>
    </joint>
    <link name="wrist_camera_link"/>
    <joint name="wrist_camera_optical_joint" type="fixed">
      <parent link="wrist_camera_link"/>
      <child link="wrist_camera_optical"/>
      <origin rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
    <link name="wrist_camera_optical"/>
    <gazebo reference="wrist_camera_link">
      <sensor name="wrist_rgbd" type="rgbd_camera">
        <topic>wrist_camera</topic>
        <gz_frame_id>wrist_camera_optical</gz_frame_id>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>1.0</far></clip>
          <depth_camera><clip><near>0.03</near><far>1.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:unless value="${hand}">
    <!-- Tool flange plus a lumped hand, cutter and camera (0.65 kg, 0.1 m long). -->
    <link name="link6">
      <visual>
        <origin xyz="0 0 ${flange / 2}"/>
        <geometry><cylinder radius="0.03" length="${flange}"/></geometry>
      </visual>
      <visual name="tool">
        <origin xyz="0 0 ${flange + 0.05}"/>
        <geometry><box size="0.08 0.06 0.10"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${flange + 0.05}"/>
        <geometry><box size="0.08 0.06 0.10"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${flange + 0.05}"/>
        <mass value="${m_tool}"/>
        <inertia ixx="${m_tool * (0.06 * 0.06 + 0.1 * 0.1) / 12}" ixy="0" ixz="0"
                 iyy="${m_tool * (0.08 * 0.08 + 0.1 * 0.1) / 12}" iyz="0"
                 izz="${m_tool * (0.08 * 0.08 + 0.06 * 0.06) / 12}"/>
      </inertial>
    </link>
    <xacro:color link="link6" rgb="0.9 0.5 0.1"/>
  </xacro:unless>

  <!-- Tool center point: between the fingertips, 1 cm behind their tips
       (with hand:=false, at the front of the lumped tool). -->
  <joint name="tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${flange + 0.10}"/>
  </joint>
  <link name="tool0"/>

  <!-- Optional payload as a small sphere at tool0. -->
  <xacro:property name="payload" value="${float(xacro.arg('payload'))}"/>
  <xacro:if value="${payload > 0}">
    <joint name="payload_joint" type="fixed">
      <parent link="tool0"/>
      <child link="payload"/>
    </joint>
    <link name="payload">
      <visual><geometry><sphere radius="0.035"/></geometry></visual>
      <inertial>
        <mass value="${payload}"/>
        <inertia ixx="${0.4 * payload * 0.035 * 0.035}" ixy="0" ixz="0"
                 iyy="${0.4 * payload * 0.035 * 0.035}" iyz="0" izz="${0.4 * payload * 0.035 * 0.035}"/>
      </inertial>
    </link>
    <xacro:color link="payload" rgb="0.85 0.1 0.1"/>
  </xacro:if>

  <!-- ===== ros2_control: position or effort commands, position/velocity/effort states ===== -->
  <xacro:property name="control_mode" value="$(arg control_mode)"/>
  <ros2_control name="AgriArmGazebo" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="control_joint" params="name">
      <joint name="${name}">
        <command_interface name="${control_mode}"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:control_joint name="joint1"/>
    <xacro:control_joint name="joint2"/>
    <xacro:control_joint name="joint3"/>
    <xacro:control_joint name="joint4"/>
    <xacro:control_joint name="joint5"/>
    <xacro:control_joint name="joint6"/>
    <!-- The hand is always position controlled (servo with its own loop). -->
    <xacro:if value="${hand}">
      <xacro:macro name="hand_joint" params="name">
        <joint name="${name}">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>
      <xacro:hand_joint name="finger_left_joint"/>
      <xacro:hand_joint name="finger_right_joint"/>
      <xacro:hand_joint name="cutter_joint"/>
    </xacro:if>
  </ros2_control>

  <xacro:macro name="grasp_joints" params="names">
    <xacro:if value="${len(names.split()) > 0}">
      <xacro:property name="first" value="${names.split()[0]}"/>
      <gazebo>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
          <parent_link>link6</parent_link>
          <child_model>${first}</child_model>
          <child_link>link</child_link>
          <attach_topic>/${first}/hand/attach</attach_topic>
          <detach_topic>/${first}/hand/detach</detach_topic>
        </plugin>
      </gazebo>
      <xacro:grasp_joints names="${' '.join(names.split()[1:])}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:grasp_joints names="$(arg grasp_objects)"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
  </gazebo>
</robot>
