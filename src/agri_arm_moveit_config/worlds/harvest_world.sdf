<?xml version="1.0"?>
<sdf version="1.8">
  <world name="harvest_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Renders the camera below. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Plant: support post, a branch (truss) along y at z 0.59 and the
         upper parts of the fruit stems. The post and branch are added to
         the MoveIt planning scene by harvest_demo, so keep them in sync.
         The stems are thin and flexible and are left out of the planning
         scene. Each ripe fruit hangs from it by a detachable joint. The
         ripe fruit stems lean sideways (left 30° to -y, right 35° to +y),
         so their grasp point is not straight above the fruit; harvest_demo
         repeats these lines in STEMS. -->
    <model name="plant">
      <static>true</static>
      <pose>0.42 0 0 0 0 0</pose>
      <link name="link">
        <collision name="post">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.9</size></box></geometry>
        </collision>
        <visual name="post">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.9</size></box></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
        <collision name="branch">
          <pose>0 0 0.59 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.01</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="branch">
          <pose>0 0 0.59 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.01</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
        <visual name="fruit_left_stem">
          <pose>0 0.16247 0.55 0.523599 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.06928</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
        <visual name="fruit_right_stem">
          <pose>0 -0.15449 0.55 -0.610865 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.07325</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
        <visual name="fruit_unripe_stem">
          <pose>0 -0.08 0.55 0 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
        <!-- The unripe fruit is not picked, so its whole stem is fixed. -->
        <visual name="fruit_unripe_lower_stem">
          <pose>0 -0.08 0.5025 0 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.035</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>fruit_left</child_model>
        <child_link>link</child_link>
        <attach_topic>/fruit_left/stem/attach</attach_topic>
        <detach_topic>/fruit_left/stem/detach</detach_topic>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>fruit_right</child_model>
        <child_link>link</child_link>
        <attach_topic>/fruit_right/stem/attach</attach_topic>
        <detach_topic>/fruit_right/stem/detach</detach_topic>
      </plugin>
    </model>
    <!-- Ripe fruit (0.15 kg) with the lower part of its stem. It hangs
         from the plant by a detachable joint (cut = detach). A second one,
         on the arm (agri_arm.urdf.xacro, grasp_objects), holds it in the
         hand after the cut. -->
    <model name="fruit_left">
      <pose>0.42 0.2 0.45 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia><ixx>7.35e-5</ixx><iyy>7.35e-5</iyy><izz>7.35e-5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name="stem">
          <pose>0 -0.01010 0.0525 0.523599 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.04041</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
      <!-- World pose on /model/fruit_left/pose, to check where it ended up. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
    </model>
    <!-- Ripe fruit (0.15 kg) with the lower part of its stem. It hangs
         from the plant by a detachable joint (cut = detach). A second one,
         on the arm (agri_arm.urdf.xacro, grasp_objects), holds it in the
         hand after the cut. -->
    <model name="fruit_right">
      <pose>0.42 -0.2 0.45 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia><ixx>7.35e-5</ixx><iyy>7.35e-5</iyy><izz>7.35e-5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name="stem">
          <pose>0 0.01225 0.0525 -0.610865 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.04273</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
      <!-- World pose on /model/fruit_right/pose, to check where it ended up. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
    </model>
    <!-- Unripe (yellow-green) fruit: fruit_detector must not pick it. -->
    <model name="fruit_unripe">
      <static>true</static>
      <pose>0.42 -0.08 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.45 0.7 0.15 1</ambient><diffuse>0.45 0.7 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Crate for the harvested fruit, on a stand. The same boxes are in
         harvest_demo's CRATE. -->
    <model name="crate">
      <static>true</static>
      <link name="link">
        <collision name="stand">
          <pose>0.05 0.42 0.05 0 0 0</pose>
          <geometry><box><size>0.24 0.2 0.1</size></box></geometry>
        </collision>
        <visual name="stand">
          <pose>0.05 0.42 0.05 0 0 0</pose>
          <geometry><box><size>0.24 0.2 0.1</size></box></geometry>
          <material><ambient>0.2 0.35 0.7 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
        </visual>
        <collision name="wall_front">
          <pose>0.165 0.42 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
        </collision>
        <visual name="wall_front">
          <pose>0.165 0.42 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
          <material><ambient>0.2 0.35 0.7 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
        </visual>
        <collision name="wall_back">
          <pose>-0.065 0.42 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
        </collision>
        <visual name="wall_back">
          <pose>-0.065 0.42 0.15 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
          <material><ambient>0.2 0.35 0.7 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
        </visual>
        <collision name="wall_left">
          <pose>0.05 0.515 0.15 0 0 0</pose>
          <geometry><box><size>0.22 0.01 0.1</size></box></geometry>
        </collision>
        <visual name="wall_left">
          <pose>0.05 0.515 0.15 0 0 0</pose>
          <geometry><box><size>0.22 0.01 0.1</size></box></geometry>
          <material><ambient>0.2 0.35 0.7 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
        </visual>
        <collision name="wall_right">
          <pose>0.05 0.325 0.15 0 0 0</pose>
          <geometry><box><size>0.22 0.01 0.1</size></box></geometry>
        </collision>
        <visual name="wall_right">
          <pose>0.05 0.325 0.15 0 0 0</pose>
          <geometry><box><size>0.22 0.01 0.1</size></box></geometry>
          <material><ambient>0.2 0.35 0.7 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Fixed RGB-D camera in front of the plant, looking back at it (-x)
         and 0.48 rad down. Its pose is repeated as a static TF in
         harvest_moveit.launch.py, so keep the two in sync. -->
    <model name="field_camera">
      <static>true</static>
      <pose>1.0 0 0.75 0 0.48 3.14159265</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.03 0.1 0.03</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="rgbd" type="rgbd_camera">
          <topic>field_camera</topic>
          <gz_frame_id>field_camera_optical</gz_frame_id>
          <update_rate>5</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
    <!-- The arm is spawned by the agri_arm launch file. -->
  </world>
</sdf>
