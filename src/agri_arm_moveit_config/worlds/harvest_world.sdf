<?xml version="1.0"?>
<sdf version="1.8">
  <world name="harvest_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Renders the camera below. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Plant support post. The same box is added to the MoveIt planning
         scene by harvest_demo, so keep the two in sync. -->
    <model name="post">
      <static>true</static>
      <pose>0.42 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.9</size></box></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Target fruit, visual only so the tool does not push it. -->
    <model name="fruit_left">
      <static>true</static>
      <pose>0.42 0.2 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Target fruit, visual only so the tool does not push it. -->
    <model name="fruit_right">
      <static>true</static>
      <pose>0.42 -0.2 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Unripe (yellow-green) fruit: fruit_detector must not pick it. -->
    <model name="fruit_unripe">
      <static>true</static>
      <pose>0.42 -0.08 0.62 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.45 0.7 0.15 1</ambient><diffuse>0.45 0.7 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Fixed RGB-D camera in front of the plant, looking back at it (-x)
         and 0.48 rad down. Its pose is repeated as a static TF in
         harvest_moveit.launch.py, so keep the two in sync. -->
    <model name="field_camera">
      <static>true</static>
      <pose>1.0 0 0.75 0 0.48 3.14159265</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.03 0.1 0.03</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="rgbd" type="rgbd_camera">
          <topic>field_camera</topic>
          <gz_frame_id>field_camera_optical</gz_frame_id>
          <update_rate>5</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
    <!-- The arm is spawned by the agri_arm launch file. -->
  </world>
</sdf>
