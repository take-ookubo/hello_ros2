<?xml version="1.0"?>
<!-- Three-joint arm based on simple_arm.urdf with a five-finger hand.
     Process with xacro to get a plain URDF. -->
<robot name="hello_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Fix the arm base to the world. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="5.0"/>
      <inertia ixx="0.054" ixy="0" ixz="0" iyy="0.054" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- joint1: turret rotates around the vertical axis. -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="2.0"/>
    <dynamics damping="1.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder length="0.2" radius="0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder length="0.2" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0032"/>
    </inertial>
  </link>

  <!-- joint2: shoulder pitch. -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="2.0"/>
    <dynamics damping="1.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.08 0.08 0.5"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.08 0.08 0.5"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="0.5"/>
      <inertia ixx="0.0107" ixy="0" ixz="0" iyy="0.0107" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- joint3: elbow pitch. -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="100.0" velocity="2.0"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2"/>
      <mass value="0.3"/>
      <inertia ixx="0.0041" ixy="0" ixz="0" iyy="0.0041" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Colors for Gazebo (URDF material colors are not used by Gazebo). -->
  <gazebo reference="base_link">
    <visual><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link1">
    <visual><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link2">
    <visual><material><ambient>0.0 0.7 0.0 1</ambient><diffuse>0.0 0.7 0.0 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link3">
    <visual><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
  </gazebo>

  <!-- Each joint follows a target angle [rad] published on /arm/<joint>/cmd_pos. -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/arm/joint1/cmd_pos</topic>
      <p_gain>40</p_gain><i_gain>0.5</i_gain><d_gain>4</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/arm/joint2/cmd_pos</topic>
      <p_gain>80</p_gain><i_gain>20</i_gain><d_gain>6</d_gain>
      <!-- Allow enough integral torque to hold the arm and hand against gravity
           (about 7 Nm at a 0.8 rad shoulder angle). -->
      <i_max>10</i_max><i_min>-10</i_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/arm/joint3/cmd_pos</topic>
      <p_gain>40</p_gain><i_gain>10</i_gain><d_gain>3</d_gain>
      <i_max>4</i_max><i_min>-4</i_min>
    </plugin>
    <!-- Publishes all joint angles on /world/arm_world/model/hello_arm/joint_state. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>
  <!-- ===== Five-finger hand ===== -->
  <!-- Each finger has a proximal and a distal joint that bend toward the palm
       front (+x). Each joint follows /hand/<joint>/cmd_pos [rad]. -->

  <xacro:property name="finger_width" value="0.016"/>
  <!-- Very light links make the PID controllers unstable at a 1 ms step, so
       the inertia about the bending axes has a lower bound. It can still be
       realized by putting more of the mass near the segment ends. The inertia
       about the long axis (z) is the uniform-box value. -->
  <xacro:property name="min_inertia" value="1e-5"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 ${z / 2}"/>
      <mass value="${mass}"/>
      <inertia ixx="${max(min_inertia, mass * (y * y + z * z) / 12)}" ixy="0" ixz="0"
               iyy="${max(min_inertia, mass * (x * x + z * z) / 12)}" iyz="0"
               izz="${mass * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="color" params="link rgb">
    <gazebo reference="${link}">
      <visual><material><ambient>${rgb} 1</ambient><diffuse>${rgb} 1</diffuse></material></visual>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="joint_controller" params="joint">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>/hand/${joint}/cmd_pos</topic>
        <p_gain>1.0</p_gain><i_gain>0.1</i_gain><d_gain>0.01</d_gain>
        <i_max>0.05</i_max><i_min>-0.05</i_min>
        <cmd_max>2</cmd_max><cmd_min>-2</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="finger_segment" params="name parent xyz rpy length">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.57" effort="2.0" velocity="4.0"/>
      <dynamics damping="0.01"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${length / 2}"/>
        <geometry><box size="${finger_width} ${finger_width} ${length}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2}"/>
        <geometry><box size="${finger_width} ${finger_width} ${length}"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.05" x="${finger_width}" y="${finger_width}" z="${length}"/>
    </link>
    <xacro:joint_controller joint="${name}"/>
  </xacro:macro>

  <xacro:macro name="finger" params="name xyz rpy:='0 0 0' proximal distal">
    <xacro:finger_segment name="${name}_proximal" parent="palm" xyz="${xyz}" rpy="${rpy}" length="${proximal}"/>
    <xacro:finger_segment name="${name}_distal" parent="${name}_proximal_link" xyz="0 0 ${proximal}" rpy="0 0 0" length="${distal}"/>
    <xacro:color link="${name}_proximal_link" rgb="0.9 0.75 0.6"/>
    <xacro:color link="${name}_distal_link" rgb="0.8 0.6 0.45"/>
  </xacro:macro>

  <joint name="wrist" type="fixed">
    <parent link="link3"/>
    <child link="palm"/>
    <origin xyz="0 0 0.4"/>
  </joint>

  <link name="palm">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.03 0.09 0.1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.03 0.09 0.1"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.15" x="0.03" y="0.09" z="0.1"/>
  </link>
  <xacro:color link="palm" rgb="0.9 0.75 0.6"/>

  <!-- The thumb sits on the side of the palm and points outward and up. -->
  <xacro:finger name="thumb" xyz="0.01 0.045 0.03" rpy="-0.9 0 0" proximal="0.035" distal="0.03"/>
  <xacro:finger name="index" xyz="0 0.03 0.1" proximal="0.045" distal="0.035"/>
  <xacro:finger name="middle" xyz="0 0.01 0.1" proximal="0.05" distal="0.04"/>
  <xacro:finger name="ring" xyz="0 -0.01 0.1" proximal="0.045" distal="0.035"/>
  <xacro:finger name="little" xyz="0 -0.03 0.1" proximal="0.035" distal="0.03"/>
</robot>
