<?xml version="1.0"?>
<!-- Three-joint arm based on simple_arm.urdf, with inertia and Gazebo plugins. -->
<robot name="hello_arm">

  <!-- Fix the arm base to the world. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="5.0"/>
      <inertia ixx="0.054" ixy="0" ixz="0" iyy="0.054" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- joint1: turret rotates around the vertical axis. -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="2.0"/>
    <dynamics damping="1.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder length="0.2" radius="0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder length="0.2" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0032"/>
    </inertial>
  </link>

  <!-- joint2: shoulder pitch. -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="2.0"/>
    <dynamics damping="1.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.08 0.08 0.5"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.08 0.08 0.5"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="0.5"/>
      <inertia ixx="0.0107" ixy="0" ixz="0" iyy="0.0107" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- joint3: elbow pitch. -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="100.0" velocity="2.0"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </visual>
    <visual name="tip">
      <origin xyz="0 0 0.42"/>
      <geometry><sphere radius="0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2"/>
      <mass value="0.3"/>
      <inertia ixx="0.0041" ixy="0" ixz="0" iyy="0.0041" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Colors for Gazebo (URDF material colors are not used by Gazebo). -->
  <gazebo reference="base_link">
    <visual><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link1">
    <visual><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link2">
    <visual><material><ambient>0.0 0.7 0.0 1</ambient><diffuse>0.0 0.7 0.0 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="link3">
    <visual><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
  </gazebo>

  <!-- Each joint follows a target angle [rad] published on /arm/<joint>/cmd_pos. -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/arm/joint1/cmd_pos</topic>
      <p_gain>40</p_gain><i_gain>0.5</i_gain><d_gain>4</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/arm/joint2/cmd_pos</topic>
      <p_gain>80</p_gain><i_gain>20</i_gain><d_gain>6</d_gain>
      <!-- Allow enough integral torque to hold the arm against gravity. -->
      <i_max>5</i_max><i_min>-5</i_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/arm/joint3/cmd_pos</topic>
      <p_gain>40</p_gain><i_gain>10</i_gain><d_gain>3</d_gain>
      <i_max>2</i_max><i_min>-2</i_min>
    </plugin>
    <!-- Publishes all joint angles on /world/arm_world/model/hello_arm/joint_state. -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>
</robot>
